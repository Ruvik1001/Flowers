COMPOSE_PROJECT_NAME=flowers-prod
GATEWAY_PORT=8080
APP_ENV=prod

POSTGRES_DB=flowers
POSTGRES_USER=flowers
POSTGRES_PASSWORD=REPLACE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg://flowers:REPLACE_ME_STRONG_PASSWORD@postgres:5432/flowers
REDIS_URL=redis://redis:6379/0

JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_SECRET
EVENT_STREAM=domain-events
BOOTSTRAP_ADMIN_EMAIL=admin@flowers.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_STRONG_ADMIN_PASSWORD

# App → local collector (HTTP)
OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_CONSOLE=0
# Collector → MonitoringPLTG (or other APM). Leave empty to keep debug-only secondary path.
OTLP_MONITORING_ENDPOINT=

RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_BYTES=5242880
DB_MIGRATE_MODE=auto
CONSUMER_LOOP=1
