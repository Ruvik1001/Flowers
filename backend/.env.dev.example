COMPOSE_PROJECT_NAME=flowers-dev
POSTGRES_DB=flowers_dev
POSTGRES_USER=flowers
POSTGRES_PASSWORD=dev-password
DATABASE_URL=postgresql+psycopg://flowers:dev-password@postgres:5432/flowers_dev
REDIS_URL=redis://redis:6379/1
JWT_SECRET=replace-dev-secret
EVENT_STREAM=domain-events-dev
OTLP_ENDPOINT=http://otel-collector:4317
RATE_LIMIT_PER_MINUTE=300
MAX_UPLOAD_BYTES=5242880
