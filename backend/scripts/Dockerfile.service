ARG SERVICE_NAME=gateway
FROM python:3.12-slim
ARG SERVICE_NAME
WORKDIR /app
COPY shared /tmp/shared
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir /tmp/shared "psycopg[binary]>=3.1" "redis>=5.0" "bcrypt==4.0.1"
COPY db /app/db
COPY scripts /app/scripts
COPY services/${SERVICE_NAME} /app
RUN pip install --no-cache-dir .
ENV PYTHONUNBUFFERED=1
ENV DB_INIT_SQL=/app/db/init.sql
EXPOSE 8000
CMD ["bash", "-lc", "python /app/scripts/migrate.py && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
