COMPOSE_PROJECT_NAME=flowers
POSTGRES_DB=flowers
POSTGRES_USER=flowers
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://flowers:change-me@postgres:5432/flowers
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
EVENT_STREAM=domain-events
OTLP_ENDPOINT=http://otel-collector:4317
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_BYTES=5242880
IDENTITY_URL=http://identity:8000
CATALOG_URL=http://catalog:8000
INVENTORY_URL=http://inventory:8000
PROCUREMENT_URL=http://procurement:8000
ASSEMBLY_URL=http://assembly:8000
SALES_URL=http://sales:8000
CASHIER_URL=http://cashier:8000
AUDIT_URL=http://audit:8000
ANALYTICS_URL=http://analytics:8000
FILES_URL=http://files:8000
